<?xml version="1.0" encoding="UTF-8"?>
<VAST version="3.0">
  <Ad id="global-ad-001">
    <InLine>
      <AdSystem>UniversalAdServer</AdSystem>
      <AdTitle>Universal Skippable Video Ad</AdTitle>

      <!-- Impression -->
      <Impression><![CDATA[
        https://ads.yourdomain.com/track/impression
      ]]></Impression>

      <Creatives>
        <Creative>
          <!-- Skip appears after 5 seconds -->
          <Linear skipoffset="00:00:05">

            <!-- MUST match video length -->
            <Duration>00:00:15</Duration>

            <!-- Tracking (safe for all players) -->
            <TrackingEvents>
              <Tracking event="start"><![CDATA[
                https://ads.yourdomain.com/track/start
              ]]></Tracking>
              <Tracking event="firstQuartile"><![CDATA[
                https://ads.yourdomain.com/track/first
              ]]></Tracking>
              <Tracking event="midpoint"><![CDATA[
                https://ads.yourdomain.com/track/mid
              ]]></Tracking>
              <Tracking event="thirdQuartile"><![CDATA[
                https://ads.yourdomain.com/track/third
              ]]></Tracking>
              <Tracking event="skip"><![CDATA[
                https://ads.yourdomain.com/track/skip
              ]]></Tracking>
              <Tracking event="complete"><![CDATA[
                https://ads.yourdomain.com/track/complete
              ]]></Tracking>
            </TrackingEvents>

            <!-- Clickthrough -->
            <VideoClicks>
              <ClickThrough><![CDATA[
                https://yourdomain.com/click
              ]]></ClickThrough>
            </VideoClicks>

            <!-- Media file (CRITICAL) -->
            <MediaFiles>
              <MediaFile
                id="mp4-720p"
                delivery="progressive"
                type="video/mp4"
                width="1280"
                height="720"
                scalable="true"
                maintainAspectRatio="true">
                <![CDATA[
                  https://basil79.github.io/vast-sample-tags/pg/24.mp4
                ]]>
              </MediaFile>
            </MediaFiles>

          </Linear>
        </Creative>
      </Creatives>

    </InLine>
  </Ad>
</VAST>
