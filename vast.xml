<?xml version="1.0" encoding="UTF-8"?>
<VAST version="3.0">
  <Ad id="skippable-ad-001">
    <InLine>
      <AdSystem>MyAdServer</AdSystem>
      <AdTitle>Skippable Video Ad</AdTitle>

      <Impression><![CDATA[
        https://example.com/track/impression
      ]]></Impression>

      <Creatives>
        <Creative>
          <Linear skipoffset="00:00:05">
            <!-- Video duration -->
            <Duration>00:00:15</Duration>

            <!-- Tracking -->
            <TrackingEvents>
              <Tracking event="start"><![CDATA[
                https://example.com/track/start
              ]]></Tracking>
              <Tracking event="skip"><![CDATA[
                https://example.com/track/skip
              ]]></Tracking>
              <Tracking event="complete"><![CDATA[
                https://example.com/track/complete
              ]]></Tracking>
            </TrackingEvents>

            <!-- Click -->
            <VideoClicks>
              <ClickThrough><![CDATA[
                https://example.com/click
              ]]></ClickThrough>
            </VideoClicks>

            <!-- Media -->
            <MediaFiles>
              <MediaFile
                delivery="progressive"
                type="video/mp4"
                width="1280"
                height="720">
                <![CDATA[
                  https://mmflix.live/storage/video/ads01.mp4
                ]]>
              </MediaFile>
            </MediaFiles>

          </Linear>
        </Creative>
      </Creatives>

    </InLine>
  </Ad>
</VAST>
